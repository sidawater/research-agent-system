{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "description": "Research Agent desktop client",
  "author": "Research Agent Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n ts,vite,electron \"tsc -p electron/tsconfig.json -w\" \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron ./dist-electron/main.js\"",
    "build": "tsc -b && vite build",
    "electron:build": "rimraf dist-electron && tsc -p electron/tsconfig.json",
    "package:win": "npm run build && npm run electron:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.0",
    "adm-zip": "^0.5.10",
    "ahooks": "^3.7.0",
    "antd": "^5.8.0",
    "highlight.js": "^11.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^38.4.0",
    "electron-builder": "^24.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.12"
  }
}
